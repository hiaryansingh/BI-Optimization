table Customer

	column CustomerKey
		dataType: int64
		summarizeBy: none
		sourceColumn: CustomerKey

	column 'Customer Name'
		dataType: string
		summarizeBy: none
		sourceColumn: CustomerName

	column City
		dataType: string
		summarizeBy: none
		sourceColumn: City

	column Segment
		dataType: string
		summarizeBy: none
		sourceColumn: Segment

	column BirthDate
		dataType: dateTime
		summarizeBy: none
		sourceColumn: BirthDate

	partition Customer = m
		mode: import
		source = Sql.Database("sql01", "SalesDW"){[Schema="dbo",Item="DimCustomer"]}[Data]
