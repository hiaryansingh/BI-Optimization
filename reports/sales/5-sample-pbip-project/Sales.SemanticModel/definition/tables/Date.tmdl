table Date
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: Year

	column Month
		dataType: string
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: MonthNo

	column MonthNo
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: MonthNo

	partition Date = m
		mode: import
		source = DimDateQuery
