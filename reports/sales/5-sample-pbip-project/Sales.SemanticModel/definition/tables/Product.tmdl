table Product

	column ProductKey
		dataType: int64
		summarizeBy: none
		sourceColumn: ProductKey

	column 'Product Name'
		dataType: string
		summarizeBy: none
		sourceColumn: ProductName

	column Color
		dataType: string
		summarizeBy: none
		sourceColumn: Color

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	column UnitPrice
		dataType: double
		summarizeBy: sum
		sourceColumn: UnitPrice

	column SupplierKey
		dataType: int64
		summarizeBy: none
		sourceColumn: SupplierKey

	partition Product = m
		mode: import
		source = Sql.Database("sql01", "SalesDW"){[Schema="dbo",Item="DimProduct"]}[Data]
