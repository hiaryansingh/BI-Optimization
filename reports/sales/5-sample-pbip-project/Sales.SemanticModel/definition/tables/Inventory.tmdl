table Inventory

	measure 'On Hand' = SUM(Inventory[OnHandQty])
		formatString: #,##0

	column SnapshotDate
		dataType: dateTime
		summarizeBy: none
		sourceColumn: SnapshotDate

	column ProductKey
		dataType: int64
		summarizeBy: none
		sourceColumn: ProductKey

	column PlantCode
		dataType: string
		summarizeBy: none
		sourceColumn: PlantCode

	column OnHandQty
		dataType: int64
		summarizeBy: sum
		sourceColumn: OnHandQty

	partition Inventory = m
		mode: import
		source = Sql.Database("sql01", "SupplyDW"){[Schema="dbo",Item="InventorySnapshot"]}[Data]
